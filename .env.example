# ==============================================================================
# COMMUNITY ENERGY EXCHANGE AI (CEE-AI) — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Instructions: Copy this file to '.env' and populate with your production or local values.
# DO NOT COMMIT actual secret keys to version control!

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT META
# ------------------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
APP_PORT=8000
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. DATABASE & TIME-SERIES LEDGER (POSTGRESQL + TIMESCALEDB)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/cee_ledger_db
TIMESCALEDB_TELEMETRY_RETENTION_DAYS=365
ENABLE_LEDGER_ZERO_SUM_INVARIANT_ASSERTIONS=true

# ------------------------------------------------------------------------------
# 3. MESSAGING & QUEUE (REDIS / CELERY)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
TELEMETRY_STREAM_TOPIC=telemetry.raw
COMMAND_DEBOUNCE_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 4. HARDWARE ABSTRACTION LAYER (HAL) OEM CONNECTORS
# ------------------------------------------------------------------------------
# Enphase Enlighten Cloud API
ENPHASE_CLIENT_ID=your_enphase_oauth_client_id
ENPHASE_CLIENT_SECRET=your_enphase_oauth_client_secret
ENPHASE_API_BASE_URL=https://api.enphaseenergy.com/api/v4

# GoodWe SEMS Cloud API
GOODWE_ACCOUNT_EMAIL=admin@palmmeadowsrwa.in
GOODWE_ACCOUNT_PASSWORD=your_goodwe_sems_password
GOODWE_API_BASE_URL=https://semsportal.com/api/v2

# Genus & L&T Smart Meter Webhook Signature Secret
SMART_METER_WEBHOOK_SECRET_HMAC=your_hmac_sha256_shared_secret_32_chars

# ------------------------------------------------------------------------------
# 5. RWA ERP & BILLING INTEGRATIONS
# ------------------------------------------------------------------------------
MYGATE_API_KEY=your_mygate_rwa_api_key
NOBROKERHOOD_API_KEY=your_nobrokerhood_rwa_api_key
DEFAULT_RWA_CODE=PALM-MEADOWS-089
RWA_CLEARING_RATE_INR_PER_KWH=9.50
RWA_PROVIDER_CREDIT_RATE_INR_PER_KWH=8.55

# ------------------------------------------------------------------------------
# 6. AI ENGINE & WEATHER INTELLIGENCE
# ------------------------------------------------------------------------------
IMD_WEATHER_FEED_URL=https://mausam.imd.gov.in/api/alerts
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
AI_MODEL_WEIGHTS_DIR=/home/user/community-energy-ai/models/weights
EMERGENCY_PRECHARGE_SOC_FLOOR_PCT=100
TIER_0_MEDICAL_MIN_SOC_RESERVE_PCT=30

# ------------------------------------------------------------------------------
# 7. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=super_secret_jwt_hmac_key_min_64_bytes_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AES_GCM_ENVELOPE_KEY_BASE64=aGVoZWhlaGVoZWhlaGVoZWhlaGVoZWhlaGVoZWhlaGU=
