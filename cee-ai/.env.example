# ==============================================================================
# CEE-AI Environment Variables Template (.env.example)
# Source: .env.example from Arena repo, adapted for Next.js + Supabase
# ==============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Database (Prisma) ---
# Note: Use connection pooling (pgbouncer=true) for serverless environments.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Google Gemini AI ---
GEMINI_API_KEY=AIzaSy...

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Energy System Defaults ---
RWA_CLEARING_RATE_INR_PER_KWH=9.50
RWA_PROVIDER_CREDIT_RATE_INR_PER_KWH=8.55
TIER_0_MEDICAL_MIN_SOC_RESERVE_PCT=30
EMERGENCY_PRECHARGE_SOC_FLOOR_PCT=100
COMMAND_DEBOUNCE_WINDOW_SECONDS=60

# --- Weather Intelligence ---
# Get your API key from openweathermap.org
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# --- Security ---
JWT_SECRET_KEY=super_secret_jwt_hmac_key_min_64_bytes_long

# --- Hardware Layer ---
# Mode: "simulated" (default) | "mqtt_edge" | "cloud_api"
# Use "simulated" for development/demo (no physical hardware needed)
# Use "mqtt_edge" when a Raspberry Pi edge gateway is deployed on-site
HARDWARE_MODE=simulated

# MQTT Edge Gateway (required only when HARDWARE_MODE=mqtt_edge)
# See hardware/docs/INTEGRATION_GUIDE.md for setup instructions
MQTT_BROKER_URL=mqtts://gateway.your-community.local:8883
MQTT_CLIENT_ID=cee-cloud-consumer
MQTT_USERNAME=cee-cloud
MQTT_PASSWORD=your_strong_mqtt_password
MQTT_CA_CERT_PATH=/etc/cee-ai/mqtt-ca.crt

# Hardware JWT — pre-provisioned to edge gateways for API authentication
# Must be the same value set in the edge gateway config.json
HARDWARE_EDGE_JWT_SECRET=super_secret_hardware_jwt_key_min_64_bytes_long_here

# Telemetry staleness TTL: readings older than this are treated as stale (seconds)
# Default: 300 (5 minutes)
HARDWARE_STALENESS_TTL_SECONDS=300
